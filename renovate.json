{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchManagers": ["npm"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Hold TypeScript below 7 until typescript-eslint supports it",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    }
  ],
  "minimumReleaseAge": "3 days",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": false
  },
  "constraints": {
    "yarn": "4.4.1"
  },
  "postUpdateOptions": ["yarnDedupeHighest"]
}
